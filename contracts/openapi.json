                },
                "error": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "$ref": "#/components/schemas/EvaluationResult"
                },
                "error": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "type": "null"
                },
                "error": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        ]
