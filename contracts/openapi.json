          "challenge_id",
          "eligible",
          "criteria",
          "total",
          "max_total",
          "score_10",
          "runs",
          "rationale",
          "evidence",
          "warnings",
          "placement",
          "rivals",
          "improvements"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "challenge_id": {
                  "const": "overall"
                }
              }
            },
            "then": {
              "properties": {
                "criteria": {
                  "not": {
                    "required": [
                      "relevance"
                    ]
                  }
                },
                "evidence": {
                  "not": {
                    "required": [
                      "relevance"
                    ]
                  }
                },
                "max_total": {
                  "const": 20
                },
                "eligible": {
                  "const": true
                }
              }
            },
            "else": {
              "properties": {
                "criteria": {
                  "required": [
                    "relevance"
                  ]
                },
                "evidence": {
                  "required": [
                    "relevance"
                  ]
                },
                "max_total": {
                  "const": 25
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "eligible": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "placement": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "EvaluationResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "challenge_results": {
            "type": "array",
