          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "minItems": 0,
            "maxItems": 30
          },
          "placement": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Placement"
              },
              {
                "type": "null"
              }
            ]
          },
          "rivals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Rival"
            },
            "minItems": 0,
            "maxItems": 3
          },
          "improvements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "minItems": 0,
            "maxItems": 3
          }
        },
