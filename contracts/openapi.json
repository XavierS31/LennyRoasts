{
  "openapi": "3.1.0",
  "info": {
    "title": "LennyRoasts MVP API",
    "version": "1.0.0",
    "description": "Frozen initial contract for three parallel AI-assisted workstreams. Contract changes require all owners to coordinate."
  },
  "paths": {
    "/api/challenges": {
      "get": {
        "operationId": "listChallenges",
        "responses": {
          "200": {
            "description": "Active challenge definitions and frozen versions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeList"
                }
              }
            }
          },
          "503": {
            "description": "Field not ready or scoring service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
    },
    "/api/evaluations": {
      "post": {
        "operationId": "createEvaluation",
        "description": "Validate input, capture frozen versions and queue scoring. Return before inference completes. General categories are automatic.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued evaluation; poll its evaluation_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationJob"
                }
              }
            }
          },
          "422": {
            "description": "Invalid payload or contract version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          },
          "503": {
            "description": "Field not ready or scoring service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
    },
    "/api/evaluations/{evaluation_id}": {
      "get": {
        "operationId": "getEvaluation",
        "parameters": [
          {
            "name": "evaluation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluation state, completed result or failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationJob"
                }
              }
            }
          },
          "404": {
            "description": "Unknown evaluation id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Submission": {
