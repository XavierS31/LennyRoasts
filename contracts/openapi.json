            "maxLength": 139
          },
          "inspiration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "what_it_does": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "how_we_built_it": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "challenges_we_ran_into": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "accomplishments": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "what_we_learned": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "whats_next": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "built_with": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true
          },
          "challenges": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "gemini",
                "elevenlabs",
                "databricks",
                "bny"
              ]
            },
            "minItems": 0,
            "maxItems": 4,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "tagline",
          "inspiration",
          "what_it_does",
          "how_we_built_it",
          "challenges_we_ran_into",
          "accomplishments",
          "what_we_learned",
          "whats_next",
          "built_with",
          "challenges"
        ],
        "description": "Canonical Devpost input. Sponsor opt-ins only in challenges; four general categories are automatic. No hidden persona, awards or seed metadata is sent to a judge."
      },
      "ChallengeId": {
        "type": "string",
        "enum": [
          "gemini",
          "elevenlabs",
          "databricks",
          "bny",
          "overall",
          "best_ai",
          "best_game",
          "most_useful"
        ]
      },
      "ContractVersion": {
        "type": "string",
        "const": "1.0.0"
      },
      "EvaluationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "$ref": "#/components/schemas/ContractVersion"
          },
          "submission": {
            "$ref": "#/components/schemas/Submission"
          }
        },
        "required": [
          "contract_version",
          "submission"
        ]
      },
      "APIError": {
