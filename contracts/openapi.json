          },
          "total": {
            "type": "integer",
            "minimum": 4,
            "maximum": 25
          },
          "max_total": {
            "type": "integer",
            "enum": [
              20,
              25
            ]
          },
          "score_10": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "eligible": {
            "type": "boolean"
          }
        },
        "required": [
          "run",
          "criteria",
          "total",
          "max_total",
          "score_10",
          "eligible"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "max_total": {
                  "const": 20
                }
              }
            },
            "then": {
              "properties": {
                "criteria": {
                  "not": {
                    "required": [
                      "relevance"
                    ]
                  }
                }
              }
            },
            "else": {
              "properties": {
                "criteria": {
                  "required": [
                    "relevance"
                  ]
                }
              }
            }
          }
        ]
      },
      "Placement": {
